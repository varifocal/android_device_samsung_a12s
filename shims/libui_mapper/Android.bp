// Shim for libexynoscamera3.so: it imports the old one-argument
// android::GraphicBufferMapper::unlock(native_handle const*) that 23.2's
// libui dropped (only the unlock(handle, unique_fd*) overload is exported).
// The shim method delegates to the exported overload; it touches no members,
// so no class-layout assumption is made (unlike the rejected SecC2 shim).
// Consumers: libexynoscamera3.so (elf_failures_all.md #1/#2), loaded by
// camera.exynos850.so, which the source camera provider hw_get_modules.

cc_library_shared {
    name: "libshim_libui_mapper",
    srcs: ["GraphicBufferMapperUnlock.cpp"],
    shared_libs: [
        "libbase",
        "libui",
    ],
    compile_multilib: "both",
    vendor: true,
}
