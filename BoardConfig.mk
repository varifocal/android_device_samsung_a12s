DEVICE_PATH := device/samsung/a12s

# Inherit the proprietary vendor configuration (generated by extract-files.py)
include vendor/samsung/a12s/BoardConfigVendor.mk

# Values below are merged from device/samsung/a21s-common/BoardConfigCommon.mk and
# ~/rom/drafts/BoardConfig.mk, and verified against stock A127FXXSDDXJ5 evidence
# (unpack_bootimg log, lpdump, blkid on lpunpack'd images, stock build.prop, DTB).
# Deviations from a21s are commented inline and summarized in the Phase 2 gate report.

## Architecture (stock abilist arm64-v8a,armeabi-v7a,armeabi; Exynos 850 = 8x Cortex-A55)
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := cortex-a55

## Architecture (Secondary)
TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := cortex-a55

## Build broken flags (owner draft; needed for duplicated prebuilt ELF blobs)
BUILD_BROKEN_DUP_RULES := true
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true

## Audio (a21s-common; ABOX audio proxy built from ./audio/proxy)
$(call soong_config_set,android_hardware_audio,run_64bit,true)
$(call soong_config_set,exynos_audio,PREDEFINED_LOW_CAPTURE_DURATION,20)
$(call soong_config_set,exynos_audio,PROXY_LIBRARY,//device/samsung/a12s:libaudioproxy)

## Boot image (stock unpack_bootimg: header v2, base 0x10000000, pagesize 2048,
## product name SRPUE06B013, dtb 128116 B in boot, cmdline below)
BOARD_BOOT_HEADER_VERSION := 2
BOARD_CUSTOM_BOOTIMG := true
BOARD_DTB_OFFSET := 0x00000000
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_INCLUDE_RECOVERY_DTBO := true
BOARD_KERNEL_BASE := 0x10000000
BOARD_KERNEL_OFFSET := 0x00008000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_KERNEL_SECOND_OFFSET := 0xf0000000
BOARD_RAMDISK_OFFSET := 0x01000000
BOARD_TAGS_OFFSET := 0x00000100

BOARD_MKBOOTIMG_ARGS := --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_MKBOOTIMG_ARGS += --base $(BOARD_KERNEL_BASE)
BOARD_MKBOOTIMG_ARGS += --pagesize $(BOARD_KERNEL_PAGESIZE)
BOARD_MKBOOTIMG_ARGS += --kernel_offset $(BOARD_KERNEL_OFFSET)
BOARD_MKBOOTIMG_ARGS += --ramdisk_offset $(BOARD_RAMDISK_OFFSET)
BOARD_MKBOOTIMG_ARGS += --tags_offset $(BOARD_TAGS_OFFSET)
BOARD_MKBOOTIMG_ARGS += --dtb_offset $(BOARD_DTB_OFFSET)
BOARD_MKBOOTIMG_ARGS += --board SRPUE06B013

# Stock boot cmdline (~/rom/logs/unpack_boot.log):
#   androidboot.hardware=exynos850 androidboot.selinux=enforce loop.max_part=7
# enforce -> permissive for bring-up per brief; bootloader override risk is known.
BOARD_KERNEL_CMDLINE := androidboot.hardware=exynos850 androidboot.selinux=permissive loop.max_part=7

## Camera
# a21s-common sets samsungCameraVars extra_ids 52,54 (its depth/macro cameras).
# Deliberately omitted for a12s: A12 camera IDs are not derivable from anything
# on disk. TODO-CAMERA: verify against stock camera provider config in Phase 4.

## Display (stock ro.sf.lcd_density=300; stock DTB fragment@lcd td4150 =
## 720x1600 @ 60 Hz; a21s value 280 is its own panel density)
BOARD_MINIMUM_DISPLAY_BRIGHTNESS := 1
TARGET_SCREEN_DENSITY := 300
TARGET_USES_VULKAN := true

## Dynamic partitions (stock lpdump_super.txt: super 5679087616,
## group_basic max 5674893312, members system/vendor/product/odm, NO system_ext;
## stock fstab has no /system_ext entry, so none can be produced)
BOARD_SUPER_PARTITION_SIZE := 5679087616
BOARD_SUPER_PARTITION_GROUPS := group_basic
BOARD_GROUP_BASIC_SIZE := 5674893312
BOARD_GROUP_BASIC_PARTITION_LIST := system vendor product odm

-include vendor/lineage/config/BoardConfigReservedSize.mk

## Filesystem (blkid on lpunpack'd stock images: TYPE=ext4 for all four;
## userdata f2fs per stock fstab; a21s builds vendor/odm as erofs instead)
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_ODMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := ext4
TARGET_COPY_OUT_ODM := odm
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_VENDOR := vendor
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true

## Graphics
## Kernel
BOARD_KERNEL_IMAGE_NAME := Image
TARGET_KERNEL_NO_GCC := true
TARGET_KERNEL_SOURCE := kernel/samsung/exynos850
# Phase 3 creates this defconfig (exynos850-a12snsxx_defconfig), per brief.
TARGET_KERNEL_CONFIG := exynos850-a12snsxx_defconfig

## Init
$(call soong_config_set,libinit,vendor_init_lib,//device/samsung/a12s:libinit_exynos3830)

## A/B
AB_OTA_UPDATER := false

## Lineage Health (values from a21s-common; Samsung sec-battery driver family,
## stock DT has samsung,sec-battery + samsung,sm5714-charger; verify on device)
$(call soong_config_set,lineage_health,charging_control_charging_path,/sys/class/power_supply/battery/batt_slate_mode)
$(call soong_config_set,lineage_health,charging_control_charging_enabled,0)
$(call soong_config_set,lineage_health,charging_control_charging_disabled,1)
$(call soong_config_set_bool,lineage_health,charging_control_supports_bypass,false)
$(call soong_config_set_bool,lineage_health,charging_control_supports_toggle,true)
$(call soong_config_set_bool,lineage_health,charging_control_supports_deadline,false)
$(call soong_config_set,lineage_health,fast_charge_node,/sys/class/sec/switch/afc_disable)
$(call soong_config_set,lineage_health,fast_charge_value_none,1)
$(call soong_config_set,lineage_health,fast_charge_value_fast_charge,0)

## VINTF (stock files, verified: dump/manifest.xml == stock vendor manifest;
## dump/compatibility_matrix.xml == stock vendor matrix; plus the 29 stock
## manifest/ fragments. Target-level is 6, not stock's 5 - the 23.2 level-5
## FCM stub has no 4.19.y kernel entry, so checkvintf rejects kernel FCM 5;
## a21s official also builds at 6. The stock vendor-ndk 33 requirement is
## dropped from the device matrix (23.2 framework manifest declares none).)
DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE += \
    hardware/samsung/vintf/samsung_framework_compatibility_matrix.xml \
    $(DEVICE_PATH)/vintf/a12s_framework_compatibility_matrix.xml
DEVICE_MANIFEST_FILE := $(DEVICE_PATH)/vintf/manifest.xml
DEVICE_MANIFEST_FILE += $(wildcard $(DEVICE_PATH)/vintf/manifest/*.xml)
DEVICE_MATRIX_FILE := $(DEVICE_PATH)/vintf/compatibility_matrix.xml

## Partitions (brief partition table + file sizes: stock boot.img 46137344,
## stock recovery.img 55574528, stock dtbo.img 8388608 - Samsung pads images to
## the partition size; cache size 209715200 verified on device with
## `blockdev --getsize64 /dev/block/by-name/cache`, same as a21s)
BOARD_BOOTIMAGE_PARTITION_SIZE := 46137344
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 55574528
BOARD_DTBOIMG_PARTITION_SIZE := 8388608
BOARD_CACHEIMAGE_PARTITION_SIZE := 209715200
# a21s uses 4096; draft's 262144 has no evidence anywhere on disk.
BOARD_FLASH_BLOCK_SIZE := 4096
BOARD_USES_METADATA_PARTITION := true
BOARD_ROOT_EXTRA_FOLDERS := efs
TARGET_NO_BOOTLOADER := true
TARGET_NO_RADIOIMAGE := true
TARGET_NO_RECOVERY := false

## DTB / DTBO
BOARD_DTB_CFG := $(DEVICE_PATH)/configs/kernel/exynos850.cfg
# Stock dtbo.img is shipped prebuilt (BOARD_PREBUILT_DTBOIMAGE below), so
# BOARD_KERNEL_SEPARATED_DTBO must stay false: with it true,
# vendor/lineage/build/tasks/kernel.mk:664 adds a rule that *generates*
# $(BOARD_PREBUILT_DTBOIMAGE) from kernel sources - i.e. writes into the
# device tree (kati: "writing to readonly directory"). With it false,
# build/make/core/Makefile:1054 installs the prebuilt copy instead.
BOARD_KERNEL_SEPARATED_DTBO := false
# Brief: keep the stock dtbo.img as a prebuilt for bring-up; Phase 3 keeps the
# source-built base DTB compatible with these overlays (stock dtbo entries:
# r00 custom0/1 = 0/0, r01 custom0/1 = 1/0x20, read from dtbo.img header).
BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/dtbo.img
# Stock recovery embeds the 346084-byte dtbo table (dtbo.img header total_size),
# not the 8 MB padded partition image. Carved copy keeps recovery.img within
# BOARD_RECOVERYIMAGE_PARTITION_SIZE (stock: kernel 38334476 + ramdisk 13938530
# + recovery_dtbo 346084 fits 55574528; with the padded 8 MB it would not).
BOARD_PREBUILT_RECOVERY_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/recovery_dtbo.img

## Platform (stock ro.board.platform=universal3830, ro.product.board=exynos850)
BOARD_VENDOR := samsung
TARGET_BOARD_PLATFORM := universal3830
TARGET_BOOTLOADER_BOARD_NAME := exynos850
TARGET_SOC := exynos850
include hardware/samsung_slsi-linaro/config/BoardConfig850.mk

## Properties
TARGET_VENDOR_PROP += $(DEVICE_PATH)/vendor.prop

## Recovery
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/configs/init/fstab.exynos850
# a21s uses ABGR_8888; draft's RGBX_8888 has no evidence - keep the reference.
TARGET_RECOVERY_PIXEL_FORMAT := ABGR_8888

## Releasetools
TARGET_RECOVERY_UPDATER_LIBS := librecovery_updater_exynos850
TARGET_RELEASETOOLS_EXTENSIONS := $(DEVICE_PATH)/releasetools

## RIL
ENABLE_VENDOR_RIL_SERVICE := true

$(call soong_config_set,cbd,protocol,sipc)

## Security (stock ro.vendor.build.security_patch=2024-10-01)
VENDOR_SECURITY_PATCH := 2024-10-01

## SELinux (permissive for first bring-up per brief; cmdline carries
## androidboot.selinux=permissive; IGNORE_NEVERALLOWS is bring-up only)
BOARD_SEPOLICY_TEE_FLAVOR := teegris
include device/lineage/sepolicy/exynos/sepolicy.mk
include device/samsung_slsi/sepolicy/sepolicy.mk

BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor
SELINUX_IGNORE_NEVERALLOWS := true

## USB (a21s-common value for exynos850 dwc3; stock DT to confirm exact node)
$(call soong_config_set,samsungUsbGadgetVars,gadget_name,13600000.dwc3)

## Verified Boot: disabled for bring-up (brief Phase 2.3). Stock ships
## vbmeta.img + vbmeta_system.img but fstab avb flags are already dropped.
BOARD_AVB_ENABLE := false

## Wi-Fi (a21s-common; stock vendor has android.hardware.wifi@1.0-service and
## Samsung SLSI Wi-Fi driver)
BOARD_WLAN_DEVICE                := slsi
BOARD_WPA_SUPPLICANT_DRIVER      := NL80211
BOARD_WPA_SUPPLICANT_PRIVATE_LIB := lib_driver_cmd_slsi
BOARD_HOSTAPD_DRIVER             := NL80211
BOARD_HOSTAPD_PRIVATE_LIB        := lib_driver_cmd_slsi
WIFI_HIDL_FEATURE_DUAL_INTERFACE := true
WIFI_HIDL_UNIFIED_SUPPLICANT_SERVICE_RC_ENTRY := true
WPA_SUPPLICANT_VERSION           := VER_0_8_X

WIFI_HIDL_FEATURE_DUAL_INTERFACE := true
