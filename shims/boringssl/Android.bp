// Shim for stock blobs that import the pre-rename BoringSSL C symbol
// sk_delete(); lineage-23.2's libcrypto only exports OPENSSL_sk_delete()
// (same semantics). Plain C forwarder, no layout involved.
// Consumers: libkeymaster_helper.so (elf_failures_all.md #3).

cc_library_shared {
    name: "libshim_boringssl",
    srcs: ["sk_delete.cpp"],
    shared_libs: [
        "libcrypto",
    ],
    compile_multilib: "both",
    vendor: true,
}
