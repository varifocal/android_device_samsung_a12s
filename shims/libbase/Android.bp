// Shim for stock blobs that import the old non-template
// android::base::Trim(std::string const&) symbol; lineage-23.2's libbase
// only exports template instantiations of Trim.
// Consumers: nfc_nci_nxpsn.so (check_elf_file failure, elf_failures_all.md #4).

cc_library_shared {
    name: "libshim_libbase",
    srcs: ["Trim.cpp"],
    shared_libs: [
        "libbase",
    ],
    compile_multilib: "both",
    vendor: true,
}
